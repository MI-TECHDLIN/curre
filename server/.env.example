# Clocked API key. Never commit a real value.
CLOCKED_API_KEY=clk_live_placeholder

# Shared secret the Flutter app sends as the X-App-Key header.
APP_KEY=placeholder-app-key

# Decide "kind" confidence threshold for an open/later outcome (0-1).
DECIDE_THRESHOLD=0.7

# Per-IP rate limits (requests per rolling hour).
PLAN_RATE_LIMIT_PER_HOUR=20
UNLOCK_RATE_LIMIT_PER_HOUR=30
